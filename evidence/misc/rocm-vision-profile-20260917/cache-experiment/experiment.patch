+/* Private experiment. Counts survive eviction and decay every 128 decode
+ * tokens. Existing pin/current-selection checks still decide eligibility. */
+static uint16_t experiment_frequency[DS4_ROCM_STREAM_CACHE_LAYER_STATS_MAX][DS4_ROCM_MAX_N_EXPERT];
+static uint64_t experiment_decode_tokens;
+static int experiment_frequency_on(void) {
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char *value = getenv("DS4_ROCM_EXPERIMENT_FREQUENCY_CACHE");
+        enabled = value && strcmp(value, "1") == 0;
+    }
+    return enabled && g_ssd_streaming_mode && !g_glm_model;
+}
+static uint32_t experiment_frequency_of(const cuda_stream_resident_expert &entry) {
+    if (!experiment_frequency_on() ||
+        entry.layer >= DS4_ROCM_STREAM_CACHE_LAYER_STATS_MAX ||
+        entry.expert >= DS4_ROCM_MAX_N_EXPERT) return 0;
+    return experiment_frequency[entry.layer][entry.expert];
+}
+static void experiment_note_route(uint32_t layer, const int32_t *ids, uint32_t count) {
+    if (getenv("DS4_ROCM_EXPERIMENT_ROUTE_TRACE")) {
+        fprintf(stderr, "ds4: experiment route layer=%u ids=", layer);
+        for (uint32_t i = 0; i < count; i++) fprintf(stderr, "%s%d", i ? "," : "", ids[i]);
+        fprintf(stderr, "\n");
+    }
+    if (!experiment_frequency_on() || layer >= DS4_ROCM_STREAM_CACHE_LAYER_STATS_MAX) return;
+    if (layer == 0 && ++experiment_decode_tokens % 128u == 0u) {
+        for (uint32_t l = 0; l < DS4_ROCM_STREAM_CACHE_LAYER_STATS_MAX; l++)
+            for (uint32_t e = 0; e < DS4_ROCM_MAX_N_EXPERT; e++) experiment_frequency[l][e] /= 2u;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        if (ids[i] >= 0 && (uint32_t)ids[i] < DS4_ROCM_MAX_N_EXPERT &&
+            experiment_frequency[layer][ids[i]] < UINT16_MAX) experiment_frequency[layer][ids[i]]++;
+    }
+}
